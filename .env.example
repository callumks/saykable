# Copy to .env.local and fill in. Without a Stripe key the site runs on the
# placeholder catalogue in src/data/items.ts and checkout is disabled.

# Stripe > Developers > API keys. Use the test key (sk_test_...) until launch.
STRIPE_SECRET_KEY=

# Stripe > Developers > Webhooks > your endpoint > Signing secret (whsec_...).
# For local dev: `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=

# Public origin, used for Checkout redirect URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
